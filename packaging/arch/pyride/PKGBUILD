prepare() {
  cd "pyrite-ide-${pkgver}"

  rm -rf flserial flutter_pty python_runtime super_tree xterm.dart code_forge
  cp -a "${srcdir}/flserial-${_flserial_commit}" flserial
  cp -a "${srcdir}/flutter_pty-${_flutter_pty_commit}" flutter_pty
  cp -a "${srcdir}/pyrite-ide-python-runtime-${_python_runtime_commit}" python_runtime
  cp -a "${srcdir}/super_tree-${_super_tree_commit}" super_tree
  cp -a "${srcdir}/xterm.dart-${_xterm_commit}" xterm.dart
  cp -a "${srcdir}/code_forge-${_code_forge_commit}" code_forge
}

build() {
  cd "pyrite-ide-${pkgver}"

  export CC=gcc
  export CXX=g++
  # jni 1.1.0's dartjni.c passes JNIEnv** to void** parameters; clang >= 16
  # promotes that to an error. Keep the upstream code, downgrade to a warning.
  export CFLAGS+=" -Wno-error=incompatible-pointer-types"
  export DART_SUPPRESS_ANALYTICS=true
  export FLUTTER_SUPPRESS_ANALYTICS=true
  export PUB_CACHE="${srcdir}/pub-cache"
  export FLET_CACHE_DIR="${srcdir}/flet-cache"
  export SERIOUS_PYTHON_SITE_PACKAGES="${PWD}/assets/python_runtime_boot"

  install -Dm644 \
    "${srcdir}/python-linux-dart-${_python_version}-${CARCH}.tar.gz" \
    "${FLET_CACHE_DIR}/python-build/v${_python_version}-${_python_build_date}/python-linux-dart-${_python_version}-${CARCH}.tar.gz"
  install -Dm755 \
    "${srcdir}/libdart_bridge-linux-${CARCH}.so" \
    "${FLET_CACHE_DIR}/dart-bridge/v${_dart_bridge_version}/libdart_bridge-linux-${CARCH}.so"

  flutter pub get
  dart run serious_python:main package assets/python_runtime_boot \
    --platform Linux \
    --asset assets/python_runtime_boot.zip
  flutter build linux --release --no-pub --build-name="${pkgver}"
}

package() {
  cd "pyrite-ide-${pkgver}"

  install -d "${pkgdir}/usr/lib/pyride"
  cp -dR --no-preserve=ownership \
    build/linux/x64/release/bundle/. "${pkgdir}/usr/lib/pyride/"

  # These Android/Tk native artifacts are unusable in the Linux bundle.
  rm -f "${pkgdir}/usr/lib/pyride/lib/libdartjni.so"
  rm -f "${pkgdir}/usr/lib/pyride/python3.14/lib-dynload/"_tkinter.*.so

  patchelf --set-rpath '$ORIGIN/lib' \
    "${pkgdir}/usr/lib/pyride/pyrite_ide"
  local _library
  for _library in "${pkgdir}/usr/lib/pyride/lib/"*.so*; do
    patchelf --set-rpath '$ORIGIN' "${_library}"
  done

  install -d "${pkgdir}/usr/bin"
  ln -s /usr/lib/pyride/pyrite_ide "${pkgdir}/usr/bin/pyride"

  install -Dm644 "${srcdir}/pyride.desktop" \
    "${pkgdir}/usr/share/applications/com.can1425.pyride.desktop"
  install -Dm644 android/app/src/main/res/mipmap-xxxhdpi/launcher_icon.png \
    "${pkgdir}/usr/share/icons/hicolor/192x192/apps/pyride.png"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
