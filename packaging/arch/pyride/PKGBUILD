pkgname=pyride
pkgver=1.2.0
pkgrel=1
pkgdesc='A modern and powerful MicroPython IDE'
arch=('x86_64')
url='https://github.com/pyrite-project/pyrite-ide'
license=('AGPL-3.0-only')
depends=(
  'glibc'
  'gtk3'
  'libepoxy'
  'libgcc'
  'libssh2'
  'libstdc++'
  'mpv'
  'openssl'
  'xdg-utils'
  'zlib'
)
makedepends=(
  'cmake'
  'flutter-bin>=3.44.4'
  'git'
  'ninja'
  'patchelf'
  'pkgconf'
  'rust'
)
options=('!debug')

_flserial_commit='7d22a292dd8da21dcc669479ff655ecd7ceae306'
_flutter_pty_commit='3254d43186b387ae6c518f52069e32423295b7db'
_python_runtime_commit='8db5a346d940f84c68e79fa4bc649af462864bef'
_super_tree_commit='9d079d1fbdd2a057f60768feb85d85db28acbf07'
_xterm_commit='1178eb1fea3b504911d4e06e95ef266d090bdd5f'
_code_forge_commit='b208c8e61802cc08d78d61fefe1c0ee8186156a5'
_python_version='3.14.7'
_python_build_date='20260921'
_dart_bridge_version='1.10.0'

source=(
  "${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
  "flserial-${_flserial_commit}.tar.gz::https://github.com/pyrite-project/flserial/archive/${_flserial_commit}.tar.gz"
  "flutter_pty-${_flutter_pty_commit}.tar.gz::https://github.com/pyrite-project/flutter_pty/archive/${_flutter_pty_commit}.tar.gz"
  "python-runtime-${_python_runtime_commit}.tar.gz::https://github.com/pyrite-project/pyrite-ide-python-runtime/archive/${_python_runtime_commit}.tar.gz"
  "super-tree-${_super_tree_commit}.tar.gz::https://github.com/pyrite-project/super_tree/archive/${_super_tree_commit}.tar.gz"
  "xterm-${_xterm_commit}.tar.gz::https://github.com/pyrite-project/xterm.dart/archive/${_xterm_commit}.tar.gz"
  "code-forge-${_code_forge_commit}.tar.gz::https://github.com/pyrite-project/code_forge/archive/${_code_forge_commit}.tar.gz"
  "python-linux-dart-${_python_version}-${CARCH}.tar.gz::https://github.com/flet-dev/python-build/releases/download/${_python_build_date}/python-linux-dart-${_python_version}-${CARCH}.tar.gz"
  "libdart_bridge-linux-${CARCH}.so::https://github.com/flet-dev/dart-bridge/releases/download/v${_dart_bridge_version}/libdart_bridge-linux-${CARCH}.so"
  'pyride.desktop'
)
noextract=("python-linux-dart-${_python_version}-${CARCH}.tar.gz")
sha256sums=(
  'c7fd987607cf090ff554a07159cdb629e40852ee4fee267c6d501221fa3a220f'
  '3dce633905ee4c5560a7de59f00a9be069cc3718039472e124713a3a033d6cf0'
  '7f62c253f344244e757d324d6a27f5be942dee1c6bce3d10ff1b564de00abaa6'
  'fe9ca6d74ccd6bb88cd09b1f0ffecfca9c3405ded2e19e81d9424e51e9cf424b'
  '12632fa4917080046e021c514848c87cc2c2e704ca25a5783bd2a3cffe0d5ecd'
  'cc4b9796df030ac0d0a7ea60ffd53b703be266b4fa500a82a229caf373183846'
  '352a771de3ace424669bf5fc876075fa69731991fbe3e80ae1294525f5625a13'
  '1ece31b3c0e2f306b364db793563da7801007f19aae16f63e2534f325ea39b81'
  'f89a2694fea152e4291f719657ee9f506ddbad271b1d769c739d6c65f0d42c15'
  'e58f1be19125edaf1d9bd002cc3a9ad414bfbd23d3a0c620367a83273936d915'
